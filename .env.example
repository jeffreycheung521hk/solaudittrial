# Copy to .env and supply your own credentials. This file is ignored by git.

# --- Pass A (config.example.yaml) ---
HELIUS_KEY=
QUICKNODE_URL=https://your-endpoint.example.invalid/

# --- Single-epoch audit (config.epoch-100.yaml) ---
# Two genuinely distinct providers. Differing only by API key on the same host
# is rejected: it is one upstream wearing two names.
PROVIDER_A_URL=https://provider-a.example.invalid/?api-key=
PROVIDER_B_URL=https://provider-b.example.invalid/?api-key=

# Local path to the verified Old Faithful CAR for epoch 100 (62.9 GB).
# Expected sha256 9f6d631833a8dfe0a4253ceede8e4af18a63603f0131a71ca5e947ba77eaec5a
OLD_FAITHFUL_EPOCH_100_CAR=/path/to/epoch-100.car
